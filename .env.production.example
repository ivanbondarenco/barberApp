# Variables de producción para docker-compose.yml.
#   cp .env.production.example .env.production   y completá lo que falta.
# .env.production NUNCA se sube a git (está en .gitignore): tiene las claves.

# ─── Dominio ─────────────────────────────────────────────────────────────────
# Tu dominio o subdominio, sin https://. Tiene que tener un registro A apuntando a la IP del VPS.
DOMAIN=turnos.tudominio.com
# El mismo, con https://. Con esto se arman los links de los mails y de Mercado Pago.
APP_URL=https://turnos.tudominio.com

# ─── Obligatoria ─────────────────────────────────────────────────────────────
# Cifra las credenciales de Mercado Pago y WhatsApp de cada barbería. Sin esto la app no arranca.
# Generala en el VPS con:   openssl rand -base64 32
# Guardala TAMBIÉN fuera del servidor (un gestor de contraseñas): si se pierde, cada barbería
# tiene que volver a cargar sus credenciales.
SECRETS_KEY=

# ─── Mails ───────────────────────────────────────────────────────────────────
# Con el correo de Hostinger (hPanel → Emails): el remitente queda en tu dominio y no cae en spam.
# Revisá los datos exactos en hPanel → Emails → Configuración del cliente de correo.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=turnos@tudominio.com
SMTP_PASSWORD=
MAIL_FROM="BarberApp <turnos@tudominio.com>"

# ─── Avisos de errores ───────────────────────────────────────────────────────
# Webhook entrante de Slack o Discord. Te avisa si falla un pago, un mail, etc.
ALERT_WEBHOOK_URL=

# ─── Avisos push ─────────────────────────────────────────────────────────────
# Notificaciones de turnos nuevos al celular del dueño y los barberos. Generalas UNA vez con:
#   npx web-push generate-vapid-keys
# Si las cambiás, cada uno tiene que volver a activar los avisos en su celular.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Backups ─────────────────────────────────────────────────────────────────
# Cuántas copias diarias conservar.
BACKUP_KEEP=14
# Remote de rclone para copiar los backups FUERA del VPS (por ejemplo gdrive:barberapp).
# Lo lee deploy/backup.sh. Ver deploy/VPS.md, paso 8.
RCLONE_REMOTE=

# ─── Opcionales ──────────────────────────────────────────────────────────────
# Mercado Pago y WhatsApp se cargan por barbería desde la app (Configuración). Estas variables
# son solo un atajo si el servidor atiende un único local.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
