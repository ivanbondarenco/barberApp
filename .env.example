# Copiá este archivo como .env.local y completá lo que uses.

# Ruta del archivo SQLite. En producción tiene que apuntar a un disco persistente.
DATABASE_PATH=./data/ds-studio.db

# Clave que cifra las credenciales de cada barbería (Mercado Pago, WhatsApp) dentro de la base.
# OBLIGATORIA en producción: sin ella la app no arranca. Mínimo 32 caracteres.
# Generala con:  openssl rand -base64 32
# Guardala fuera del servidor también: si se pierde, las barberías tienen que volver a cargar
# sus credenciales. Si se filtra, cambiala y que las vuelvan a cargar.
SECRETS_KEY=

# ─── Mercado Pago ────────────────────────────────────────────────────────────
# Una sola aplicación de Mercado Pago para toda la instalación (Tus integraciones →
# tu aplicación). Cada barbería conecta SU cuenta desde Configuración → Conexiones con el
# botón "Conectar con Mercado Pago" (OAuth): las señas entran directo a su cuenta.
#
# Client ID y Client Secret de la aplicación (Credenciales de producción).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Firma secreta del webhook (Configuración de webhooks). SIN ESTO EL WEBHOOK RECHAZA TODO:
# es lo que permite verificar que la notificación viene de Mercado Pago.
MP_WEBHOOK_SECRET=

# ─── WhatsApp Cloud API ──────────────────────────────────────────────────────
# Lo normal es cargarlas desde Configuración → Conexiones,
# que las guarda por barbería. Sin esto, los clientes y el equipo no pueden
# recuperar su contraseña por su cuenta.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Plantilla de autenticación aprobada por Meta, con el código como único parámetro.
WA_TEMPLATE=otp_code
WA_LANGUAGE=es_AR

# ─── Avisos de errores ───────────────────────────────────────────────────────
# Webhook entrante de Slack o Discord (o cualquier URL que reciba un POST con JSON). Cada error
# del servidor (un pago que no se acreditó, un mail que no salió) llega ahí, sin datos de clientes.
# Sin esto los errores solo quedan en el log.
ALERT_WEBHOOK_URL=

# ─── Solo desarrollo ─────────────────────────────────────────────────────────
# Con OTP_DEBUG=1 los códigos NO se envían: viajan en la respuesta de la API para
# poder probar el registro sin una cuenta de Meta. NUNCA lo actives en producción:
# cualquiera podría leer el código de otro.
# OTP_DEBUG=1

# Con SEED_DEMO=1 la primera visita crea una barbería de demostración con datos ficticios.
# En producción NO lo actives: la base tiene que arrancar vacía y llevar al alta real.
# SEED_DEMO=1

# OTP_DEBUG y SEED_DEMO no funcionan con NODE_ENV=production (la app no arranca si están).
# La única excepción es E2E_TEST_MODE=1, que usan los tests E2E contra localhost.

# ─── Mails (SMTP) ────────────────────────────────────────────────────────────
# Uno solo para toda la instalación, no por barbería: los mails de cuenta
# (bienvenida, confirmar el email, recuperar la contraseña) son de la app, porque
# la cuenta del cliente sirve para todas las barberías. En los mails de turnos el
# remitente lleva el nombre del local y se responde a su casilla.
# Sin esto la app funciona igual, pero no manda ningún mail.
SMTP_HOST=
# 587 con STARTTLS (lo habitual) o 465 directo sobre TLS.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Forzar TLS desde el saludo. Vacío: se deduce del puerto (465 = sí).
# SMTP_SECURE=1
# Remitente. El dominio tiene que estar autorizado a enviar (SPF/DKIM) o cae en spam.
MAIL_FROM="BarberApp <turnos@tudominio.com>"

# Dirección pública de la app: con esto se arman los links de los mails.
APP_URL=http://localhost:3000

# Backups (scripts/backup.mjs): dónde guardarlos y cuántas copias conservar.
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14
